+"""Strict bounded-memory helpers for fixed-width binary float PLY files."""
+
+from __future__ import annotations
+
+import os
+from dataclasses import dataclass
+from pathlib import Path
+
+import numpy as np
+
+
+@dataclass(frozen=True)
+class BinaryFloatPly:
+    path: Path
+    vertex_count: int
+    properties: tuple[str, ...]
+    obj_info: tuple[str, ...]
+    data_offset: int
+    dtype: np.dtype
+
+    @property
+    def expected_size(self):
+        return self.data_offset + self.vertex_count * self.dtype.itemsize
+
+
+def read_binary_float_ply(path):
+    path = Path(path)
+    properties = []
+    obj_info = []
+    vertex_count = None
+    current_element = None
+    format_seen = False
+    with path.open("rb") as stream:
+        first = stream.readline()
+        if first.rstrip(b"\r\n") != b"ply":
+            raise ValueError("invalid PLY magic: {}".format(path))
+        consumed = len(first)
+        while consumed <= 2 * 1024 * 1024:
+            raw = stream.readline()
+            if not raw:
+                raise ValueError("unterminated PLY header: {}".format(path))
+            consumed += len(raw)
+            try:
+                line = raw.decode("ascii").strip()
+            except UnicodeDecodeError as exc:
+                raise ValueError("non-ASCII PLY header: {}".format(path)) from exc
+            if line == "end_header":
+                data_offset = stream.tell()
+                break
+            if not line or line.startswith("comment "):
+                continue
+            fields = line.split()
+            if fields[0] == "format":
+                if fields[1:] != ["binary_little_endian", "1.0"] or format_seen:
+                    raise ValueError("unsupported PLY format: {}".format(line))
+                format_seen = True
+            elif fields[0] == "obj_info":
+                obj_info.append(line[len("obj_info "):])
+            elif fields[0] == "element":
+                if len(fields) != 3 or fields[1] != "vertex" or vertex_count is not None:
+                    raise ValueError("only one vertex element is supported: {}".format(path))
+                vertex_count = int(fields[2])
+                if vertex_count < 0:
+                    raise ValueError("negative PLY vertex count: {}".format(path))
+                current_element = "vertex"
+            elif fields[0] == "property":
+                if (
+                    current_element != "vertex"
+                    or len(fields) != 3
+                    or fields[1] not in ("float", "float32")
+                    or fields[2] in properties
+                ):
+                    raise ValueError("unsupported PLY property: {}".format(line))
+                properties.append(fields[2])
+            else:
+                raise ValueError("unsupported PLY header line: {}".format(line))
+        else:
+            raise ValueError("PLY header exceeds size limit: {}".format(path))
+
+    if not format_seen or vertex_count is None or not properties:
+        raise ValueError("incomplete PLY header: {}".format(path))
+    dtype = np.dtype([(name, "<f4") for name in properties])
+    layout = BinaryFloatPly(
+        path=path.resolve(),
+        vertex_count=vertex_count,
+        properties=tuple(properties),
+        obj_info=tuple(obj_info),
+        data_offset=data_offset,
+        dtype=dtype,
+    )
+    if path.stat().st_size != layout.expected_size:
+        raise ValueError(
+            "PLY byte size mismatch for {}: expected {}, found {}".format(
+                path, layout.expected_size, path.stat().st_size
+            )
+        )
+    return layout
+
