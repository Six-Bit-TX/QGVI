+@torch.no_grad()
+def prefilter_explicit_gaussians(viewpoint_camera, pc, visible_mask):
+    """Remove radius-zero explicit Gaussians with bounded projection scratch."""
+    if pc.gs_attr != "3D":
+        raise ValueError("explicit frustum prefilter currently requires 3D Gaussians")
+    vertex_count = pc._xyz.shape[0]
+    if (
+        visible_mask.dtype != torch.bool
+        or visible_mask.shape != (vertex_count,)
+        or visible_mask.device != pc._xyz.device
+    ):
+        raise ValueError("invalid explicit Gaussian visibility mask")
+    chunk_size = int(
+        os.environ.get("HORIZONGS_EXPLICIT_PREFILTER_CHUNK_SIZE", "4194304")
+    )
+    if chunk_size <= 0:
+        raise ValueError("HORIZONGS_EXPLICIT_PREFILTER_CHUNK_SIZE must be positive")
+
+    K = torch.tensor([
+        [viewpoint_camera.fx, 0, viewpoint_camera.cx],
+        [0, viewpoint_camera.fy, viewpoint_camera.cy],
+        [0, 0, 1],
+    ], dtype=torch.float32, device=pc._xyz.device)[None]
+    viewmats = viewpoint_camera.world_view_transform.transpose(0, 1)[None]
+    fallback_index = None
+
+    for start in range(0, vertex_count, chunk_size):
+        end = min(start + chunk_size, vertex_count)
+        chunk_mask = visible_mask[start:end]
+        selected = torch.nonzero(chunk_mask, as_tuple=False).squeeze(1)
+        if selected.numel() == 0:
+            continue
+        if fallback_index is None:
+            fallback_index = start + int(selected[0].item())
+        means = torch.index_select(pc._xyz[start:end], 0, selected)
+        quats = torch.index_select(pc._rotation[start:end], 0, selected)
+        scales = torch.index_select(pc._scaling[start:end], 0, selected)
+        opacities = torch.index_select(pc._opacity[start:end, 0], 0, selected)
+        projection = fully_fused_projection(
+            means,
+            None,
+            quats,
+            scales,
+            viewmats,
+            K,
+            int(viewpoint_camera.image_width),
+            int(viewpoint_camera.image_height),
+            eps2d=0.3,
+            packed=False,
+            near_plane=0.01,
+            far_plane=1e10,
+            radius_clip=0.0,
+            sparse_grad=False,
+            calc_compensations=False,
+            opacities=opacities,
+        )
+        radii = projection[0].squeeze(0)
+        if radii.ndim > 1:
+            radii = radii.amax(dim=-1)
+        chunk_mask[selected] = radii > 0
+        del selected, means, quats, scales, opacities, projection, radii
+
+    # A single known radius-zero sentinel lets gsplat produce the exact empty
+    # background without relying on version-specific N=0 kernel behavior.
+    if fallback_index is not None and not bool(torch.any(visible_mask).item()):
+        visible_mask[fallback_index] = True
+    return visible_mask
+
 
